{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "src": "/(css|js|images|favicon.ico)(.*)",
      "dest": "/public/$1$2"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "CONFIG_CACHE": "/tmp/config.php",
    "ROUTES_CACHE": "/tmp/routes.php",
    "SERVICES_CACHE": "/tmp/services.php",
    "PACKAGES_CACHE": "/tmp/packages.php",
    "VIEW_COMPILED_PATH": "/tmp"
  }
}
