APP_NAME=SmartStaff-Ethiopia
APP_ENV=production
APP_KEY=base64:randomGeneratedKeyHere=
APP_DEBUG=false
APP_URL=https://your-app-name.vercel.app

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# የ Clever Cloud MySQL ዳታቤዝ መረጃዎችን እዚህ ይተካሉ
DB_CONNECTION=mysql
DB_HOST=bxxxxxxxxxxxx-mysql.services.clever-cloud.com
DB_PORT=3306
DB_DATABASE=bxxxxxxxxxxxx
DB_USERNAME=uxxxxxxxxxxxx
DB_PASSWORD=pxxxxxxxxxxxx

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
